# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml /app/
COPY patches /app/patches
COPY packages/types/package.json /app/packages/types/package.json
COPY packages/ui/package.json /app/packages/ui/package.json
COPY ee/packages/utils/package.json /app/ee/packages/utils/package.json
# Client-safe telemetry contracts: source-only package (no build step) that
# den-web compiles through transpilePackages. Keep the server-side
# @offlinegpt-ee/telemetry package (and its den-db graph) out of this image.
COPY ee/packages/telemetry-contracts/package.json /app/ee/packages/telemetry-contracts/package.json
COPY ee/apps/den-web/package.json /app/ee/apps/den-web/package.json

RUN pnpm install --frozen-lockfile --trust-lockfile --filter @offlinegpt-ee/den-web...

COPY packages/types /app/packages/types
COPY packages/ui /app/packages/ui
COPY ee/packages/utils /app/ee/packages/utils
COPY ee/packages/telemetry-contracts /app/ee/packages/telemetry-contracts
COPY ee/apps/den-web /app/ee/apps/den-web

# @offlinegpt-ee/utils resolves to dist/ in production builds and nothing else in
# this image builds it; without this step a cold (cache-miss) image build fails
# in next build with "Can't resolve '@offlinegpt-ee/utils'".
RUN pnpm --dir /app/ee/packages/utils run build

WORKDIR /app/ee/apps/den-web

RUN pnpm run build

EXPOSE 3005

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || '3005') + '/api/health').then((res) => process.exit(res.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["sh", "-lc", "/app/ee/apps/den-web/node_modules/.bin/next start --hostname 0.0.0.0 --port ${PORT:-3005}"]
