# OpenAI-compatible model gateway for the OfflineGPT Workspace edition.
# Build from the repository root:
#   docker build -f packaging/platform/Dockerfile.model-gateway -t offlinegpt-platform-model-gateway .
FROM node:24-bookworm-slim AS build
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/* \n  && npm install -g pnpm@11.4.0
COPY . .
RUN pnpm install --frozen-lockfile --prod --filter "@offlinegpt-platform/model-gateway..."

FROM oven/bun:1.3.14-slim
WORKDIR /app
COPY --from=build /src/node_modules ./node_modules
COPY --from=build /src/platform ./platform
ENV NODE_ENV=production PORT=8791
USER bun
EXPOSE 8791
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD bun -e "fetch('http://127.0.0.1:8791/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["bun", "platform/apps/model-gateway/src/main.ts"]
