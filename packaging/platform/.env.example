# OfflineGPT Workspace edition settings. Copy to .env and fill in.

# The address employees open (put your TLS reverse proxy in front of port 8790).
PUBLIC_URL=https://offlinegpt.example.internal
CONTROL_PORT=8790
# Employees' workspaces: the same host on its own port (the sign-in cookie is shared across ports).
WORKSPACE_PUBLIC_URL=https://offlinegpt.example.internal:8793
WORKSPACE_PORT=8793

# First owner: open PUBLIC_URL, choose "First-time setup", and enter this email and code.
OWNER_EMAIL=it-admin@example.internal
# At least 16 characters, e.g. `openssl rand -base64 24`.
SETUP_CODE=
# Encrypts stored credentials for company tool connections (32+ characters,
# for example: openssl rand -base64 48). Keep it: changing it makes stored
# credentials unreadable.
SECRETS_KEY=
# Optional: forward every audit event to your SIEM, e.g. udp://siem.internal:514
AUDIT_SYSLOG=
# Days a leaver's workspace files are kept after SCIM deactivation (0 = forever).
WORKSPACE_RETENTION_DAYS=90
# Snapshot every workspace's files this often (hours; 0 = off), keeping the newest few.
WORKSPACE_CHECKPOINT_HOURS=24
WORKSPACE_CHECKPOINTS_KEPT=7
# Optional meaning-based knowledge search: an OpenAI-compatible embeddings
# endpoint inside your network (e.g. a second vLLM serving an embedding model).
EMBEDDINGS_URL=
EMBEDDINGS_MODEL=

POSTGRES_PASSWORD=

# Single sign-on (OIDC). Register the redirect URI <PUBLIC_URL>/auth/oidc/callback with your IdP.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Or SAML 2.0, for identity providers without OIDC. Give your IdP the metadata
# at <PUBLIC_URL>/auth/saml/metadata. Set both to turn it on.
SAML_ENTRY_POINT=
# The IdP's signing certificate (PEM, or its base64 body on one line).
SAML_IDP_CERT=

# The model: a folder under MODELS_PATH holding Hugging Face weights.
MODELS_PATH=/srv/offlinegpt/models
MODEL_DIR=Qwen2.5-7B-Instruct
MODEL_ALIAS=main
MODEL_DISPLAY_NAME=Qwen 2.5 7B
MODEL_CONTEXT_LENGTH=16384
# How vLLM reads tool calls: hermes for Qwen 2.5, llama3_json for Llama 3.x, mistral for Mistral.
MODEL_TOOL_PARSER=hermes
# Lower on small GPUs (0.75 on a 4 GB card).
GPU_MEMORY_UTILIZATION=0.85

# Optional: tokens each person may use per UTC day. Empty means no limit.
DAILY_TOKEN_LIMIT=

# The per-employee workspace image (built by the `build` profile).
WORKSPACE_IMAGE=offlinegpt-workspace:local
